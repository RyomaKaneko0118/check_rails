# cp .env.example .env して、POSTGRES_PASSWORD を自分で埋めること。
# パスワード生成例: openssl rand -hex 16
#
# このファイルはコミットされる雛形なので、実際の値は書かない。
# compose.yaml の ${...} 補間に使われ、コンテナへは environment: 経由で渡る。
#
# DB 名はここでは持たない。config/database.yml が環境ごとに決める
# (check_rails_development / check_rails_test)。

POSTGRES_USER=postgres
POSTGRES_PASSWORD=

RAILS_ENV=development
TZ=Asia/Tokyo
